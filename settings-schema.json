{
    "use-24h": {
        "type": "checkbox",
        "default": true,
        "description": "Use 24-hour clock"
    },
    "show-date": {
        "type": "checkbox",
        "default": true,
        "description": "Show the date below the time"
    },
    "font-size": {
        "type": "spinbutton",
        "default": 36,
        "min": 8,
        "max": 144,
        "step": 1,
        "units": "pt",
        "description": "Time font size"
    },
    "text-color": {
        "type": "colorchooser",
        "default": "rgb(255,255,255)",
        "description": "Text colour"
    }
}
